# Copy to .env. Never commit .env. Secrets such as DEEPSEEK_API_KEY live in ../../secrets/secrets.env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated, empty disables auth (local only).
API_KEYS=
# Keys of the lab's own apps (Tiketa's agent): they skip the daily caps meant for visitors.
TRUSTED_API_KEYS=
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# Hosted OpenAI-compatible upstream (DeepSeek reads DEEPSEEK_API_KEY from ../../secrets/secrets.env)
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_MODEL=deepseek-flash
UPSTREAM_TIMEOUT_SECONDS=120

# Only for INJECTION_GUARD=decision: openai_logprobs (any OpenAI /chat/completions with top_logprobs) or
# systemone (Jev /v1/systemone)
DECISION_PROTOCOL=openai_logprobs
DECISION_BASE_URL=https://api.deepseek.com
DECISION_MODEL=deepseek-flash
DECISION_TIMEOUT_SECONDS=15

# Local LLM server instead (`transformers serve --port 8090`):
# UPSTREAM_BASE_URL=http://localhost:8090/v1
# UPSTREAM_API_KEY=local
# UPSTREAM_MODEL=Qwen/Qwen3.5-0.8B
# DECISION_PROTOCOL=systemone
# DECISION_BASE_URL=http://localhost:8090
# DECISION_MODEL=Qwen/Qwen3.5-2B

# jev (TypeSafe's Jev, needs JEV_API_KEY), classifier (local DeBERTa), cascade (the classifier, then Jev to
# confirm a block) or decision (the decision endpoint). See README "Injection guards compared"
INJECTION_GUARD=jev
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=15
INJECTION_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# With Jev, the bilingual question kept every ordinary message at 0.16 or below and attacks at 0.97 or above
# (README "Bilingual guard"). 0.98 is the operating point of the larger 25 Oct evaluation of the older question
BLOCK_FROM_INJECTION_PROBABILITY=0.90
# Jev also asks whether a message is clearly outside the allowed scope. A request's own `scope` replaces this one
BLOCK_FROM_OFF_TOPIC_PROBABILITY=0.90
# DEFAULT_ALLOWED_SCOPE=general business, software and AI engineering, data analysis, customer support, and cinema or service operations
# Scopes an app sends by name (scope_name), shown with their guard questions at GET /v1/gate/scopes:
# NAMED_SCOPES={"tiketa": "booking cinema tickets at Tiketa"}
DEVICE=cuda

# Instructions in tool results and tool calls the user did not ask for. Needs JEV_API_KEY (docs/experiments/agent-guards.md)
AGENT_GUARD_ENABLED=true
BLOCK_FROM_TOOL_RESULT_PROBABILITY=0.9428
TOOL_CALL_ASKED_BELOW=0.5
TOOL_CALL_SCOPE_FROM=0.7

# Gemini Decision 1 answers the guard's questions when Jev fails. Up to three keys, the next one on a 429.
# Free tier keys: Google may use what is sent, so demo data only
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Off by default: the tagger knows Indonesian only. On, it masks personal data before anything leaves the host
MASK_IDENTIFIERS_ENABLED=false
# The local tagger that masks personal data, on the CPU. Downloaded once, pinned to one revision
IDENTIFIER_MODEL=AIbnuHibban/indopii-base
IDENTIFIER_MODEL_REVISION=4e12679e7bdb6505a495f7dfab9ab01565d1d109
IDENTIFIER_SPAN_THRESHOLD=0.5
IDENTIFIER_THREADS=4

CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=3600
EVENT_LOG_SIZE=500

# Shared rate limit and answer cache (docker compose up -d redis). Empty keeps both per process, local only.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
DAILY_REQUESTS_PER_CALLER=0
DAILY_REQUESTS_TOTAL=0
