# Copy to .env. Never commit .env. Secrets such as DEEPSEEK_API_KEY live in ../../secrets/secrets.env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated, empty disables auth (local only).
API_KEYS=
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# Hosted OpenAI-compatible upstream (DeepSeek reads DEEPSEEK_API_KEY from ../../secrets/secrets.env)
UPSTREAM_BASE_URL=https://api.deepseek.com
SMALL_MODEL=deepseek-flash
STRONG_MODEL=deepseek-v4-pro
UPSTREAM_TIMEOUT_SECONDS=120

# Decision endpoint: openai_logprobs (any OpenAI /chat/completions with top_logprobs) or systemone (Jev /v1/systemone)
DECISION_PROTOCOL=openai_logprobs
DECISION_BASE_URL=https://api.deepseek.com
DECISION_MODEL=deepseek-flash
DECISION_TIMEOUT_SECONDS=15
STRONG_FROM_DIFFICULTY=1.0

# Local LLM server instead (`transformers serve --port 8090`):
# UPSTREAM_BASE_URL=http://localhost:8090/v1
# UPSTREAM_API_KEY=local
# SMALL_MODEL=Qwen/Qwen3.5-0.8B
# STRONG_MODEL=Qwen/Qwen3.5-2B
# DECISION_PROTOCOL=systemone
# DECISION_BASE_URL=http://localhost:8090
# DECISION_MODEL=Qwen/Qwen3.5-2B

# jev (TypeSafe's Jev, needs JEV_API_KEY), classifier (local DeBERTa), cascade (the classifier, then Jev to
# confirm a block) or decision (the decision endpoint). See README "Injection guards compared"
INJECTION_GUARD=jev
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=15
INJECTION_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# 0.98 keeps wrong blocks near zero with Jev (docs/experiments/injection-guard-thresholds.md)
BLOCK_FROM_INJECTION_PROBABILITY=0.98
DEVICE=cuda

CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=3600
EVENT_LOG_SIZE=500

# Shared rate limit and answer cache (docker compose up -d redis). Empty keeps both per process, local only.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
